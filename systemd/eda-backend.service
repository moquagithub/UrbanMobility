[Unit]
Description=Data Quiz EDA Backend (FastAPI) - Zero Authorization
After=network.target

[Service]
Type=simple
User=dgxuser
WorkingDirectory=/opt/eda/backend
Environment=PYTHONUNBUFFERED=1
Environment=MPLBACKEND=Agg
Environment=CORS_ALLOWED_ORIGINS=*
Environment=EDA_ANON_SALT=dgx_prod_salt
ExecStart=/opt/eda/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
