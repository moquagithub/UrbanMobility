# =========================================================================
#  .env TEMPLATE — Mobimix
#  Rename to ".env" at the project root and fill in the values.
#  Ask Youness for the actual secrets (private channel — never by email).
# =========================================================================

# ---- Database ----------------------------------------------------------
DB_HOST=mysql                 # Docker service name — NOT localhost
DB_PORT=3306
DB_NAME=urbain_automation
DB_USER=root
DB_PASSWORD=<ask_youness>

# ---- Object storage ----------------------------------------------------
MINIO_ENDPOINT=minio:9000     # internal container-to-container address
MINIO_ACCESS_KEY=<ask_youness>
MINIO_SECRET_KEY=<ask_youness>    # must be at least 8 characters
MINIO_SECURE=false

# ---- HuggingFace (model download, only if deploying your own vLLM) -----
HF_TOKEN=<your_own_token>

# ---- LLM routing -------------------------------------------------------
# Cloud first for speed, automatic fallback to local when quota runs out.
LLM_ROUTER_ORDER=Groq,NVIDIA
GROQ_API_KEY=<ask_youness_or_use_your_own>
GROQ_MODEL=llama-3.1-8b-instant

NVIDIA_NIM_API_KEY=dummy      # must be non-empty; the value is ignored by vLLM
NVIDIA_NIM_BASE_URL=http://vllm:8000/v1
NVIDIA_NIM_MODEL=NousResearch/Meta-Llama-3.1-8B-Instruct

# Code default is 45 s — far too short for local inference (~90 s per call)
LLM_REQUEST_TIMEOUT_SEC=600

# ---- Web interface -----------------------------------------------------
APP_PASSWORD=<choose_one>     # avoid ! $ and backticks (shell interpretation)

# =========================================================================
#  PRIVACY RULE
#  The configuration above sends part of the workload to a free cloud tier.
#  Free tiers are funded by user prompts.
#  For REAL user data, switch to local-only inference:
#      LLM_ROUTER_ORDER=NVIDIA
# =========================================================================

# ---- Scenario B only: reusing the existing vLLM from another project ----
# If you deploy a separate stack, do NOT start a second vLLM (15 GB wasted
# on an already-loaded machine). Point at the running one instead:
# NVIDIA_NIM_BASE_URL=http://172.17.0.1:8100/v1
