# .env.example (racine du repo — pour `docker compose up`)
# ============================================================
# Copiez ce fichier en `.env` à la racine avant `docker compose up`.
# L'application est en accès libre : aucun secret d'authentification requis.

# Port exposé par nginx sur la machine hôte — http://localhost:${NGINX_PORT}
# est le point d'entrée de l'application une fois `docker compose up` lancé.
NGINX_PORT=8090

# CORS : sans effet pour un accès via nginx (même origine), utile seulement
# si le backend est aussi appelé directement sur son port exposé (:8000).
CORS_ALLOWED_ORIGINS=*

# Salt d'anonymisation PII (DQE-6) — a un défaut de dev, à surcharger en prod.
EDA_ANON_SALT=change_me_in_production
